# ShinyOS — opções aplicadas por cima do "make defconfig" do BusyBox
CONFIG_STATIC=y
CONFIG_PIE=n
CONFIG_EXTRA_CFLAGS=""
# Implementações próprias de passwd/group/shadow (não depende de NSS)
CONFIG_USE_BB_PWD_GRP=y
CONFIG_USE_BB_SHADOW=y
CONFIG_USE_BB_CRYPT=y
CONFIG_USE_BB_CRYPT_SHA=y
CONFIG_FEATURE_DEFAULT_PASSWD_ALGO="sha512"
# Init estilo SysV com /etc/inittab
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_FEATURE_INIT_SCTTY=y
CONFIG_FEATURE_INIT_SYSLOG=y
CONFIG_FEATURE_INITRD=y
# Shell
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_HISTORY=500
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
# HTTPS no wget
CONFIG_FEATURE_WGET_HTTPS=y
CONFIG_SSL_CLIENT=y
# Não compila com headers de kernel recentes
CONFIG_TC=n
CONFIG_FEATURE_TC_INGRESS=n
CONFIG_RFKILL=y
