# wpa_supplicant da ShinyOS (nl80211, OpenSSL, estático)
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_TLS=openssl
CONFIG_TLSV11=y
CONFIG_TLSV12=y

CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_SME=y
CONFIG_AP=y

# WPA2/WPA3, 802.11w, redes abertas com OWE
CONFIG_SAE=y
CONFIG_OWE=y
CONFIG_IEEE80211W=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y

# Redes corporativas (eduroam etc.)
CONFIG_IEEE8021X_EAPOL=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_TLS=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_GTC=y
CONFIG_EAP_MD5=y

CONFIG_INTERWORKING=y
CONFIG_HS20=y
CONFIG_BGSCAN_SIMPLE=y
CONFIG_AUTOSCAN_EXPONENTIAL=y
CONFIG_DEBUG_SYSLOG=y

LIBS += -lssl -lcrypto -lpthread
LIBS_c += -lssl -lcrypto
LIBS_p += -lssl -lcrypto
