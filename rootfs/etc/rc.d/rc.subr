# /etc/rc.d/rc.subr — funções comuns aos scripts de serviço
# Cada serviço define: name, command, command_args (opcional), pidfile (opcional)
# e então chama: run_rc_command "$1"

. /etc/rc.conf
export PATH=/sbin:/bin:/usr/sbin:/usr/bin

_ok()   { printf '\033[1;35m*\033[0m %-28s [\033[1;32m ok \033[0m]\n' "$1"; }
_fail() { printf '\033[1;35m*\033[0m %-28s [\033[1;31mfalhou\033[0m]\n' "$1"; }

rc_start()  { start-stop-daemon -S -q -p "$pidfile" -x "$command" -- $command_args; }
rc_stop()   { start-stop-daemon -K -q -p "$pidfile" -x "$command"; }
rc_status() { start-stop-daemon -K -t -q -p "$pidfile" -x "$command"; }

run_rc_command() {
    : "${pidfile:=/run/$name.pid}"
    case $1 in
        start)
            if type start_cmd >/dev/null 2>&1; then start_cmd; else rc_start; fi \
                && _ok "Iniciando $name" || _fail "Iniciando $name" ;;
        stop)
            if type stop_cmd >/dev/null 2>&1; then stop_cmd; else rc_stop; fi \
                && _ok "Parando $name" || _fail "Parando $name" ;;
        restart)
            "$0" stop; sleep 1; "$0" start ;;
        status)
            if type status_cmd >/dev/null 2>&1; then status_cmd; else rc_status; fi \
                && echo "$name está rodando" || { echo "$name está parado"; return 3; } ;;
        *)
            echo "uso: $0 start|stop|restart|status"; return 1 ;;
    esac
}
