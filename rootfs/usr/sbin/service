#!/bin/sh
# service <nome> start|stop|restart|status
# service -l  — lista os serviços e se estão habilitados no /etc/rc.conf

if [ "$1" = -l ] || [ $# -eq 0 ]; then
    . /etc/rc.conf
    for f in /etc/rc.d/*; do
        n=${f##*/}
        [ "$n" = rc.subr ] && continue
        eval e=\$${n}_enable
        printf '%-12s %s\n' "$n" "${e:-NO}"
    done
    exit 0
fi

if [ ! -x "/etc/rc.d/$1" ]; then
    echo "service: serviço '$1' não existe em /etc/rc.d" >&2
    exit 1
fi
exec "/etc/rc.d/$1" "${2:-status}"
